{
  "config": {
    "experiment": {
      "name": "attention_unfolding",
      "description": "LmmseNetAtt 对照 LmmseNet/GRU，5e4 大训练池",
      "seed": 42,
      "use_cuda": true,
      "save_dir": "results",
      "plot_dir": "plots"
    },
    "channel": {
      "n_tx": 4,
      "n_rx": 4,
      "n_pilot": 16,
      "snr_list": [
        0,
        5,
        10,
        15,
        20,
        25,
        30
      ],
      "n_samples": 50000,
      "type": "rayleigh",
      "pilot_type": "random"
    },
    "data": {
      "augmentation": {
        "enabled": false,
        "methods": [
          "phase_shift",
          "magnitude_scale"
        ],
        "phase_shift_range": [
          -3.14159,
          3.14159
        ],
        "magnitude_scale_range": [
          0.8,
          1.25
        ]
      },
      "split": {
        "train_ratio": 0.7,
        "val_ratio": 0.15
      },
      "loader": {
        "batch_size": 128,
        "num_workers": 4,
        "pin_memory": false
      }
    },
    "traditional": {
      "ls": {
        "regularization": true,
        "lambda": 0.01
      },
      "lmmse": {
        "correlation_method": "theoretical",
        "noise_var_estimation": "oracle"
      }
    },
    "dl": {
      "input_modes": [
        "ls_refine_x"
      ],
      "models": [
        "GRU",
        "LmmseNet",
        "LmmseNetAtt"
      ]
    },
    "models": {
      "common": {
        "learning_rate": 0.001,
        "dropout": 0.3
      },
      "rnn": {
        "hidden_size": 256,
        "num_layers": 2
      },
      "lstm": {
        "hidden_size": 256,
        "num_layers": 2
      },
      "gru": {
        "hidden_size": 256,
        "num_layers": 2
      },
      "hybrid": {
        "rnn_hidden_size": 256
      }
    },
    "training": {
      "epochs": 100,
      "early_stopping": {
        "patience": 10
      }
    },
    "evaluation": {
      "n_test": 2000,
      "n_trials": 3,
      "ber_symbols": 100,
      "equalizer": "mmse"
    }
  },
